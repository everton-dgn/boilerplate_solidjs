{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": [
      "node",
      "vite/client",
      "vite-plus/test/globals",
      "@solidjs/vite-plugin/boundary-modules"
    ],
    "tsBuildInfoFile": ".tsbuild/app.tsbuildinfo"
  },
  "include": ["src"]
}
