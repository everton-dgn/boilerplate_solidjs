{
  "name": "boilerplate_solidjs",
  "version": "1.12.6",
  "private": true,
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "description": "A SolidJS boilerplate with TypeScript, Vite+, server-side rendering, and automated testing.",
  "repository": "https://github.com/everton-dgn/boilerplate_solidjs",
  "scripts": {
    "dev": "bun --bun node_modules/vite-plus/bin/vp dev",
    "dev:phone": "bun --bun node_modules/vite-plus/bin/vp dev --host 0.0.0.0",
    "build": "bun --bun node_modules/vite-plus/bin/vp build",
    "start": "vp preview",
    "i18n:generate": "vpr i18n-generate",
    "typecheck": "vpr i18n:generate && vpr typecheck-app && vpr typecheck-node",
    "typecheck:node": "vpr i18n:generate && vpr typecheck-node",
    "lint": "vpr i18n:generate && vpr lint-project",
    "lint:css": "vpr lint-css",
    "format": "vp fmt",
    "check:ci": "vpr i18n:generate && vpr check-project",
    "check:fix": "vpr i18n:generate && vp check --fix",
    "test": "vpr i18n:generate && vp test run",
    "test:tooling": "vpr test-tooling",
    "test:release": "bun test --isolate --timeout=60000 tooling/release",
    "test:ui": "vpr i18n:generate && vp test --ui --coverage",
    "test:ci": "vpr i18n:generate && vp test run --bail=1 --coverage",
    "test:coverage": "vpr i18n:generate && vp test run --coverage",
    "test:unit": "vpr i18n:generate && vp test run --project node --project dom",
    "test:watch": "vpr i18n:generate && vp test watch",
    "test:shuffle": "vpr i18n:generate && vp test run --sequence.shuffle",
    "test:browser": "vpr i18n:generate && vp test run --project browser",
    "test:browser:install": "vp exec playwright install chromium",
    "test:e2e": "playwright test --config tooling/playwright.ts",
    "test:e2e:production": "TEST_PRODUCTION_ROUTES=true playwright test --config tooling/playwright.ts",
    "test:e2e:ui": "playwright test --config tooling/playwright.ts --ui",
    "test:e2e:codegen": "playwright codegen",
    "deps:update": "vp update --interactive --latest",
    "bun:update": "vp env pin bun@latest && vp install",
    "detect:duplicates": "vp dlx jscpd src --pattern '**/*.{ts,tsx}' --reporters console",
    "dead-code": "vpr i18n:generate && vpr dead-code-project",
    "dead-code:fix": "knip-bun --config tooling/knip.ts --fix --format",
    "scan:secrets": "kingfisher scan . --git-history none --no-validate --redact --exclude node_modules --exclude dist --exclude dist-ssr --exclude .nitro --exclude .output --exclude .vercel --exclude .tsbuild --exclude playwright-report --exclude test-results --exclude coverage --exclude .vitest",
    "validate": "vpr check:ci && vpr typecheck:node && vpr test:coverage && vpr test:tooling && vpr test:release && vpr build",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.29.0",
    "@mdream/js": "2.0.3",
    "@solidjs/router": "2.0.0-next.40",
    "@solidjs/web": "2.0.0-rc.15",
    "filesystem-routing": "0.4.0",
    "solid-js": "2.0.0-rc.15",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@iconify-json/hugeicons": "1.2.35",
    "@inlang/plugin-message-format": "4.5.4",
    "@inlang/sdk": "4.0.4",
    "@playwright/test": "1.64.1",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint-plugin-solid": "0.18.1",
    "happy-dom": "21.0.3",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "nitro": "3.0.260903-beta",
    "playwright": "1.64.1",
    "schema-dts": "2.1.0",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-use-nesting": "6.0.2",
    "typescript": "7.0.2",
    "unplugin-icons": "24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "esbuild",
    "lefthook"
  ],
  "workspaces": {
    "packages": [],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
      "vitest": "5.0.4",
      "vite-plus": "1.2.0",
      "@vitest/browser-playwright": "5.0.4",
      "@vitest/coverage-v8": "5.0.4",
      "@vitest/ui": "5.0.4"
    }
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.15",
    "@solidjs/compiler": "2.0.0-rc.15",
    "vite@*": "catalog:",
    "vitest@*": "catalog:"
  },
  "patchedDependencies": {
    "@mdream/js@2.0.3": "patches/@mdream%2Fjs@2.0.3.patch",
    "@voidzero-dev/vite-plus-core@1.2.0": "patches/@voidzero-dev%2Fvite-plus-core@1.2.0.patch",
    "@solidjs/web@2.0.0-rc.15": "patches/@solidjs%2Fweb@2.0.0-rc.15.patch",
    "solid-js@2.0.0-rc.15": "patches/solid-js@2.0.0-rc.15.patch"
  }
}
