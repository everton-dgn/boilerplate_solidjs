{
  "name": "boilerplate_solidjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --build",
    "lint": "vp lint",
    "format": "vp fmt",
    "check:ci": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:unit": "vp test run --project node --project jsdom",
    "test:watch": "vp test watch",
    "test:browser": "vp test run --project browser",
    "test:browser:install": "vp exec playwright install chromium",
    "validate": "pnpm typecheck && pnpm check:ci && pnpm test && pnpm build",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.23",
    "@solidjs/web": "2.0.0-rc.7",
    "solid-js": "2.0.0-rc.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@solidjs/vite-plugin": "3.0.0-next.42",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint-plugin-solid": "0.18.0",
    "jsdom": "30.0.1",
    "lefthook": "2.1.12",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "0.3.1",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.1.0",
      "onFail": "download"
    }
  }
}
