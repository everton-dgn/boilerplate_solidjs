{
  "name": "boilerplate_solidjs",
  "version": "1.7.0",
  "private": true,
  "author": "Éverton Toffanetto",
  "license": "MIT",
  "description": "A SolidJS boilerplate with TypeScript, Vite+, server-side rendering, and automated testing.",
  "repository": "https://github.com/everton-dgn/boilerplate_solidjs",
  "scripts": {
    "dev": "vp dev",
    "dev:phone": "vp dev --host 0.0.0.0",
    "build": "vp build",
    "start": "vp preview",
    "typecheck": "vp run typecheck-app && vp run typecheck-node",
    "typecheck:node": "vp run typecheck-node",
    "lint": "vp run lint-project",
    "lint:css": "vp run lint-css",
    "format": "vp fmt",
    "check:ci": "vp run check-project",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "test:tooling": "vp run test-tooling",
    "test:ui": "vp test --ui --coverage",
    "test:ci": "vp test run --bail=1 --coverage",
    "test:coverage": "vp test run --coverage",
    "test:unit": "vp test run --project node --project dom",
    "test:watch": "vp test watch",
    "test:shuffle": "vp test run --sequence.shuffle",
    "test:browser": "vp test run --project browser",
    "test:browser:install": "vp exec playwright install chromium",
    "test:e2e": "playwright test --config tooling/playwright.ts",
    "test:e2e:production": "TEST_PRODUCTION_ROUTES=true playwright test --config tooling/playwright.ts",
    "test:e2e:ui": "playwright test --config tooling/playwright.ts --ui",
    "test:e2e:codegen": "playwright codegen",
    "deps:update": "pnpm update --interactive --latest",
    "pnpm:update": "pnpm self-update && vp install",
    "detect:duplicates": "pnpm dlx jscpd src --pattern '**/*.{ts,tsx}' --reporters console",
    "dead-code": "vp run dead-code-project",
    "dead-code:fix": "knip --config tooling/knip.ts --fix --format",
    "scan:secrets": "kingfisher scan . --git-history none --no-validate --redact --exclude node_modules --exclude dist --exclude dist-ssr --exclude .nitro --exclude .output --exclude .vercel --exclude .tsbuild --exclude playwright-report --exclude test-results --exclude coverage --exclude .vitest",
    "validate": "pnpm check:ci && pnpm typecheck:node && pnpm test:coverage && pnpm test:tooling && pnpm build",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.30",
    "@solidjs/web": "2.0.0-rc.11",
    "filesystem-routing": "0.4.0",
    "solid-js": "2.0.0-rc.11",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@iconify-json/hugeicons": "1.2.35",
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint-plugin-solid": "0.18.0",
    "happy-dom": "20.14.5",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "nitro": "3.0.260903-beta",
    "playwright": "1.63.0",
    "schema-dts": "2.0.0",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-use-nesting": "6.0.2",
    "typescript": "7.0.2",
    "unplugin-icons": "24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
